{
  "name": "vibe-server-status-app",
  "version": "15.0.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "author": "ServerLens Delivery",
  "description": "A RetroUI-inspired server health, runtime, security, and ecosystem analysis desktop app.",
  "scripts": {
    "start": "node src/server/index.js",
    "desktop": "electron .",
    "package:app": "node scripts/package-desktop.js",
    "handoff:dir": "node scripts/create-handoff-package.js",
    "pack:dir": "electron-builder --dir",
    "runtime:smoke": "node scripts/runtime-smoke.js",
    "ui:evidence": "node scripts/ui-visual-evidence.js",
    "delivery:validate": "node scripts/delivery-validate.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-check.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "com.vibeserverstatus.serverlens",
    "productName": "ServerLens",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    }
  }
}
